\addvspace {10\p@ }
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces \textbf {Baseline density profile evolution.} The central density decreases steadily over time, with the steepest change occurring early and the later evolution approaching a shallower, but still declining, trend. The vertical dashed line indicates the softening reference radius $r_{\rm ref} = 2.8\,\epsilon $. The lower panel shows the density ratio relative to the initial conditions.}}{26}{figure.caption.12}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Velocity dispersion $\sigma _{\mathrm {1D}}(r)$ and orbital anisotropy $\beta (r)$ evolution up to 100 Gyr for a softening length value of $\epsilon = 0.01$ kpc.}}{29}{figure.caption.13}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces \textbf {Box size study.} Comparison of the three tested simulation volumes (100, 200, 500 $kpc^3$). The central density diagnostic shows the same secular decline across volumes.}}{31}{figure.caption.14}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces \textbf {Core initial condition density profile evolution.} The upper panel shows the density evolution over time. The lower panel shows the density ratio relative to the initial conditions.}}{32}{figure.caption.15}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces \textbf {Softening length study.} Comparison of the set of tested softening lengths ($\epsilon = 1$, $5$, $10$, $50$, and $100\,\mathrm {pc}$) at 50 Gyr (left) and 100 Gyr (right).}}{33}{figure.caption.16}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces \textbf {Self-gravity parameter study.} Panels show the central density evolution for the tested solver settings: timestep factor $\eta $ (top left); MAC choice (top right); geometric opening angle $\theta _{\mathrm {cr}}$ (bottom left); FMM tolerance $\epsilon _{\mathrm {fmm}}$ (bottom right). In each panel blue curves correspond to 10 Gyr and red curves to 100 Gyr.}}{36}{figure.caption.18}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces \textbf {NFW enclosed mass and shell mass fraction.} Left axis: increasing enclosed mass $M(<r)$ with radius. Right axis: shell mass fraction per logarithmic shell.}}{39}{figure.caption.19}%
\contentsline {figure}{\numberline {4.8}{\ignorespaces \textbf {Shell contributions to the central potential depth.} Blue points represent the contribution of each shell to the total potential depth $|\Phi (0)|$. The cumulative contribution from all shells beyond a given radius is plotted in orange.}}{39}{figure.caption.20}%
\contentsline {figure}{\numberline {4.9}{\ignorespaces \textbf {Outer-potential fraction versus cutoff radius.} For probe radii ranging from the center to $r = 5 r_s$, the fraction of the potential originating from material beyond the cutoff radius $r_{\mathrm {cut}}$ is plotted against the cutoff. As the cutoff moves outward, the outer contribution remains constant initially before dropping sharply as it approaches the outer edge of the system.}}{40}{figure.caption.21}%
\contentsline {figure}{\numberline {4.10}{\ignorespaces \textbf {Gravitational potential distributions under baseline and truncated interaction ranges.} Left to right, top to bottom: vanilla \textit {SWIFT} (no truncation), and truncated implementations with $R_{\mathrm {cut}} = 1$, $2$, $3$, $5$, $10$, $25$, and $50$ kpc.}}{43}{figure.caption.23}%
\contentsline {figure}{\numberline {4.11}{\ignorespaces Orbit of example particle crossing the truncation boundary of $R_{\rm cut} = 10$ kpc. Left to right, top to bottom: $x$ vs $y$, $x$ vs $z$, $y$ vs $z$, and $r$ vs $t$ projections.}}{45}{figure.caption.24}%
\contentsline {figure}{\numberline {4.12}{\ignorespaces Summary of multiple selected orbits crossing the truncation boundary. The vertical dashed line indicates the truncation radius $R_{\rm cut}$.}}{45}{figure.caption.25}%
\contentsline {figure}{\numberline {4.13}{\ignorespaces Density profile evolution of the hybrid model with a cutoff of $R_{\rm cut} = 10$ kpc.}}{46}{figure.caption.26}%
\contentsline {figure}{\numberline {4.14}{\ignorespaces Study of smaller $R_{\rm cut}$ values. From left to right, top to bottom: $R_{\rm cut} = 5$, $3$, $2$, $1$, $0.5$, $0.3$, $0.2$, $0.1$, $0.05$, $0.03$, $0.02$ and $0.01$ kpc.}}{47}{figure.caption.27}%
\contentsline {figure}{\numberline {4.15}{\ignorespaces \textbf {Density ratio comparison.} Each panel shows the ratio of the density profile for a given $R_{\rm cut}$ value. The top left panel corresponds to $R_{\rm cut} = 5$ kpc, and subsequent panels show progressively smaller truncation radii down to $R_{\rm cut} = 0.02$ kpc.}}{48}{figure.caption.28}%
\contentsline {figure}{\numberline {4.16}{\ignorespaces Comparison of the set of tested $R_{\rm cut}$ values (from $R_{\rm cut} = 1$ kpc down to $R_{\rm cut} = 0.02$ kpc) at 50 Gyr (left) and 100 Gyr (right).}}{49}{figure.caption.29}%
