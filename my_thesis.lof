\contentsline {figure}{\numberline {1.1}{\ignorespaces \textbf {[PLACEHOLDER FIGURE]} Cusp versus core density profiles.}}{2}{figure.caption.6}%
\contentsline {figure}{\numberline {1.2}{\ignorespaces \textbf {[PLACEHOLDER FIGURE]} Central density evolution over 100 Gyr.}}{3}{figure.caption.7}%
