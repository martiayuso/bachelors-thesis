\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces \textbf {Spherical shell decomposition.} Four renderings of the same sphere, partitioned into 2, 4 and 8 concentric spherical shells.}}{17}{figure.caption.10}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces High-level control-flow schematic of the truncated-NFW implementation. The figure highlights the split between parameter initialization, source-side masking, gravity-kernel evaluation, target-side write-back suppression, and the external analytic field used for outer particles.}}{21}{figure.caption.11}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces \textbf {Particle distribution of the simulation.} The same system is shown at three increasing apertures $r_{\mathrm {max}}$.}}{29}{figure.caption.12}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces \textbf {Multiscale view of the gravitational potential.} The same particle distribution is shown with progressively increasing aperture size $r_{\mathrm {max}}$, revealing how the potential structure transitions from a strongly centralised well at small radii to a more extended field at larger scales. The deepest regions remain consistently centred, while outer structure becomes increasingly visible as the field of view expands.}}{30}{figure.caption.13}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces \textbf {Baseline density-profile evolution.} The central density decreases steadily over time, with the steepest change occurring early and the later evolution approaching a shallower, but still declining, trend. The gradient structure is consistent with a secular redistribution rather than a settled core.}}{31}{figure.caption.14}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces \textbf {Baseline evolution with ratio to the initial state.} The upper panel shows the density evolution over time. The lower panel shows the density ratio relative to the initial conditions.}}{32}{figure.caption.15}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces \textbf {Box-size study.} Comparison of the three tested simulation volumes (small, intermediate, large). The central-density diagnostic (inner radial bin) shows the same secular decline across volumes; changing the box size modifies the depletion rate only modestly.}}{33}{figure.caption.16}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces \textbf {Particle distribution of the core simulation.} The same system is shown at three increasing apertures $r_{\mathrm {max}}$.}}{35}{figure.caption.17}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces \textbf {Multiscale view of the core gravitational potential.} The same particle distribution is shown with progressively increasing aperture size $r_{\mathrm {max}}$, revealing how the potential structure transitions from a strongly centralised well at small radii to a more extended field at larger scales. The deepest regions remain consistently centred, while outer structure becomes increasingly visible as the field of view expands.}}{36}{figure.caption.18}%
\contentsline {figure}{\numberline {4.8}{\ignorespaces \textbf {Core initial condition density-profile evolution.} The cored halo also shows a decline in central density, although with a smaller amplitude than the cuspy case. This directly contradicts a simple expectation of core formation followed by stabilization.}}{37}{figure.caption.19}%
\contentsline {figure}{\numberline {4.9}{\ignorespaces \textbf {Core initial condition evolution with ratio to the initial state.} The upper panel shows the density evolution over time. The lower panel shows the density ratio relative to the initial conditions.}}{38}{figure.caption.20}%
\contentsline {figure}{\numberline {4.10}{\ignorespaces \textbf {Softening study.} Comparison of the same set of tested softening lengths at 50 Gyr (left) and 100 Gyr (right). The shorter-time view highlights the earlier evolution, while the longer-time view shows that the same hierarchy of softening runs follows the same qualitative trend. The smallest softening still shows a slight central-density increase close to the center, which is better interpreted as numerical heating than as a real improvement of the physical problem.}}{39}{figure.caption.21}%
\contentsline {figure}{\numberline {4.11}{\ignorespaces \textbf {Self-gravity parameter study.} Panels show the central-density evolution for the tested solver settings: top-left -- timestep factor $\eta $; top-right -- MAC choice; bottom-left -- geometric opening angle $\theta _{\mathrm {cr}}$; bottom-right -- FMM tolerance $\epsilon _{\mathrm {fmm}}$. In each panel blue curves correspond to 10 Gyr and red curves to 100 Gyr.}}{43}{figure.caption.23}%
\contentsline {figure}{\numberline {4.12}{\ignorespaces \textbf {NFW enclosed mass and shell mass fraction.} Left axis: monotonically increasing enclosed mass $M(<r)$ with radius. Right axis: shell mass fraction per logarithmic shell.}}{44}{figure.caption.24}%
\contentsline {figure}{\numberline {4.13}{\ignorespaces \textbf {Shell contributions to the central potential depth.} Individual shells (blue points with error bars) contribute to the total potential depth $|\Phi (0)|$. The cumulative contribution (orange line) from all shells beyond a given radius shows that shells at radii beyond the scale radius $r_s$ still make substantial contributions to the escape-speed scale.}}{45}{figure.caption.25}%
\contentsline {figure}{\numberline {4.14}{\ignorespaces \textbf {Outer-potential fraction versus cutoff radius.} For probe radii ranging from the center to $r = 5 r_s$, the fraction of the potential originating from material beyond the cutoff radius $r_{\mathrm {cut}}$ is plotted against the cutoff. As the cutoff moves outward, the outer contribution drops sharply initially, then plateaus. For the central region ($r_{\mathrm {probe}} < r_s$), a cutoff at $r_{\mathrm {cut}} \approx 10$ kpc retains roughly 5--10\% of the potential from the outer halo; at $r_{\mathrm {cut}} \approx 30$ kpc, this drops below 1\%. Thus, if the outer halo contributes significantly to the potential at the radii of interest (e.g., $r < 1$ kpc for the central density), then the outer region must be represented accurately.}}{46}{figure.caption.26}%
\contentsline {figure}{\numberline {4.15}{\ignorespaces \textbf {2D map of the outer-potential fraction.} Rows represent probe radii; columns represent cutoff radii. The color intensity indicates the fraction of potential at a given probe radius arising from material beyond the cutoff. The transition from high (red) to low (blue) values shows the radius beyond which the outer halo becomes a small correction.}}{47}{figure.caption.27}%
\contentsline {figure}{\numberline {4.16}{\ignorespaces \textbf {Particle distribution of the simulation.} The same system is shown at three increasing apertures $r_{\mathrm {max}}$.}}{49}{figure.caption.28}%
\contentsline {figure}{\numberline {4.17}{\ignorespaces \textbf {Multiscale view of the gravitational potential.} The same particle distribution is shown with progressively increasing aperture size $r_{\mathrm {max}}$, revealing how the potential structure transitions from a strongly centralised well at small radii to a more extended field at larger scales. The deepest regions remain consistently centred, while outer structure becomes increasingly visible as the field of view expands.}}{50}{figure.caption.29}%
\contentsline {figure}{\numberline {4.18}{\ignorespaces \textbf {Baseline density-profile evolution.} The central density decreases steadily over time, with the steepest change occurring early and the later evolution approaching a shallower, but still declining, trend. The gradient structure is consistent with a secular redistribution rather than a settled core.}}{51}{figure.caption.30}%
\contentsline {figure}{\numberline {4.19}{\ignorespaces \textbf {Baseline evolution with ratio to the initial state.} The upper panel shows the density evolution over time. The lower panel shows the density ratio relative to the initial conditions.}}{52}{figure.caption.31}%
