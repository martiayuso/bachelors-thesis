\contentsline {figure}{\numberline {2.3}{\ignorespaces Simulation examples from the SWIFT gallery \citep {swiftgallery2024}.}}{11}{figure.caption.9}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces High-level control-flow schematic of the truncated-NFW implementation. The figure highlights the split between parameter initialization, source-side masking, gravity-kernel evaluation, target-side write-back suppression, and the external analytic field used for outer particles.}}{17}{figure.caption.12}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces \textbf {Baseline density-profile evolution.} The central density decreases steadily over time, with the steepest change occurring early and the later evolution approaching a shallower, but still declining, trend. The gradient structure is consistent with a secular redistribution rather than a settled core.}}{27}{figure.caption.13}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Velocity dispersion and orbital anisotropy evolution up to 100 Gyr for a softening length value of $\epsilon = 0.01$ kpc.}}{30}{figure.caption.14}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces \textbf {Box-size study.} Comparison of the three tested simulation volumes (small, intermediate, large). The central-density diagnostic (inner radial bin) shows the same secular decline across volumes; changing the box size modifies the depletion rate only modestly.}}{32}{figure.caption.15}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces \textbf {Core initial condition density-profile evolution with ratio to the initial state.} The upper panel shows the density evolution over time. The lower panel shows the density ratio relative to the initial conditions.}}{33}{figure.caption.16}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces \textbf {Softening study.} Comparison of the same set of tested softening lengths ($\epsilon = 1$, $5$, $10$, $50$, and $100\,\mathrm {pc}$) at 50 Gyr (left) and 100 Gyr (right).}}{34}{figure.caption.17}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces \textbf {Self-gravity parameter study.} Panels show the central-density evolution for the tested solver settings: top-left -- timestep factor $\eta $; top-right -- MAC choice; bottom-left -- geometric opening angle $\theta _{\mathrm {cr}}$; bottom-right -- FMM tolerance $\epsilon _{\mathrm {fmm}}$. In each panel blue curves correspond to 10 Gyr and red curves to 100 Gyr.}}{37}{figure.caption.19}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces \textbf {NFW enclosed mass and shell mass fraction.} Left axis: increasing enclosed mass $M(<r)$ with radius. Right axis: shell mass fraction per logarithmic shell.}}{40}{figure.caption.20}%
\contentsline {figure}{\numberline {4.8}{\ignorespaces \textbf {Shell contributions to the central potential depth.} Blue points represent the contribution of each shell to the total potential depth $|\Phi (0)|$. The cumulative contribution from all shells beyond a given radius is plotted in orange.}}{40}{figure.caption.21}%
\contentsline {figure}{\numberline {4.9}{\ignorespaces \textbf {Outer-potential fraction versus cutoff radius.} For probe radii ranging from the center to $r = 5 r_s$, the fraction of the potential originating from material beyond the cutoff radius $r_{\mathrm {cut}}$ is plotted against the cutoff. As the cutoff moves outward, the outer contribution drops sharply initially, then plateaus. For the central region ($r_{\mathrm {probe}} < r_s$), a cutoff at $r_{\mathrm {cut}} \approx 10$ kpc retains roughly 5--10\% of the potential from the outer halo; at $r_{\mathrm {cut}} \approx 30$ kpc, this drops below 1\%. Thus, if the outer halo contributes significantly to the potential at the radii of interest (e.g., $r < 1$ kpc for the central density), then the outer region must be represented accurately.}}{41}{figure.caption.22}%
\contentsline {figure}{\numberline {4.10}{\ignorespaces \textbf {Gravitational potential distributions under baseline and truncated interaction ranges.} Left to right, top to bottom: vanilla \textit {SWIFT} (no truncation), and truncated implementations with $R_{\mathrm {cut}} = 50$, $25$, $10$, $5$, $3$, $2$, and $1$ kpc.}}{44}{figure.caption.24}%
\contentsline {figure}{\numberline {4.11}{\ignorespaces Orbit of example particle crossing the truncation boundary of $R_{\rm cut} = 10$ kpc.}}{46}{figure.caption.25}%
\contentsline {figure}{\numberline {4.12}{\ignorespaces Summary of multiple selected orbits crossing the truncation boundary. The vertical dashed line indicates the truncation radius $R_{\rm cut}$.}}{46}{figure.caption.26}%
\contentsline {figure}{\numberline {4.13}{\ignorespaces Density profile evolution of the hybrid model.}}{47}{figure.caption.27}%
\contentsline {figure}{\numberline {4.14}{\ignorespaces \textbf {$R_{\rm cut}$ study large plot.}}}{48}{figure.caption.28}%
\contentsline {figure}{\numberline {4.15}{\ignorespaces \textbf {Density ratio comparison}}}{49}{figure.caption.29}%
\contentsline {figure}{\numberline {4.16}{\ignorespaces \textbf {Rcut comparison.}}}{50}{figure.caption.30}%
