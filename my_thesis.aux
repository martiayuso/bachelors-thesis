\@writefile{lof}{\contentsline {figure}{\numberline {4.15}{\ignorespaces \textbf  {2D map of the outer-potential fraction.} Rows represent probe radii; columns represent cutoff radii. The color intensity indicates the fraction of potential at a given probe radius arising from material beyond the cutoff. The transition from high (red) to low (blue) values shows the radius beyond which the outer halo becomes a small correction.}}{47}{figure.caption.27}\protected@file@percent }
\newlabel{fig:results_shell_map}{{4.15}{47}{\textbf {2D map of the outer-potential fraction.} Rows represent probe radii; columns represent cutoff radii. The color intensity indicates the fraction of potential at a given probe radius arising from material beyond the cutoff. The transition from high (red) to low (blue) values shows the radius beyond which the outer halo becomes a small correction}{figure.caption.27}{}}
