\@writefile{toc}{\contentsline {subsection}{\numberline {4.8.2}Mass and potential distribution across the halo}{33}{subsection.4.8.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.9}{\ignorespaces \textbf  {NFW enclosed mass and shell mass fraction.} Left axis: monotonically increasing enclosed mass $M(<r)$ with radius. Right axis: shell mass fraction per logarithmic shell. The outer halo contains a substantial fraction of the total mass budget, indicating that it cannot be ignored when computing potential depths.}}{34}{figure.caption.17}\protected@file@percent }
\newlabel{fig:results_shell_mass}{{4.9}{34}{\textbf {NFW enclosed mass and shell mass fraction.} Left axis: monotonically increasing enclosed mass $M(<r)$ with radius. Right axis: shell mass fraction per logarithmic shell. The outer halo contains a substantial fraction of the total mass budget, indicating that it cannot be ignored when computing potential depths}{figure.caption.17}{}}
\BKM@entry{id=59,dest={73756273656374696F6E2E342E382E33},srcline={229}}{}
\@writefile{lof}{\contentsline {figure}{\numberline {4.10}{\ignorespaces \textbf  {Shell contributions to the central potential depth.} Individual shells (blue points with error bars) contribute to the total potential depth $|\Phi (0)|$. The cumulative contribution (orange line) from all shells beyond a given radius shows that shells at radii beyond the scale radius $r_s$ still make substantial contributions to the escape-speed scale. This supports the argument that the outer halo cannot be treated as a boundary condition; its potential structure must be represented accurately.}}{35}{figure.caption.18}\protected@file@percent }
\newlabel{fig:results_shell_potential}{{4.10}{35}{\textbf {Shell contributions to the central potential depth.} Individual shells (blue points with error bars) contribute to the total potential depth $|\Phi (0)|$. The cumulative contribution (orange line) from all shells beyond a given radius shows that shells at radii beyond the scale radius $r_s$ still make substantial contributions to the escape-speed scale. This supports the argument that the outer halo cannot be treated as a boundary condition; its potential structure must be represented accurately}{figure.caption.18}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.8.3}Outer-halo influence as a function of cutoff radius}{35}{subsection.4.8.3}\protected@file@percent }
\BKM@entry{id=60,dest={73756273656374696F6E2E342E382E34},srcline={242}}{5C3337365C3337375C303030325C303030445C3030305C3034305C3030306F5C303030755C303030745C303030655C303030725C3030302D5C303030665C303030725C303030615C303030635C303030745C303030695C3030306F5C3030306E5C3030305C3034305C3030306D5C303030615C30303070}
\@writefile{lof}{\contentsline {figure}{\numberline {4.11}{\ignorespaces \textbf  {Outer-potential fraction versus cutoff radius.} For probe radii ranging from the center to $r = 5 r_s$, the fraction of the potential originating from material beyond the cutoff radius $r_{\mathrm  {cut}}$ is plotted against the cutoff. As the cutoff moves outward, the outer contribution drops sharply initially, then plateaus. For the central region ($r_{\mathrm  {probe}} < r_s$), a cutoff at $r_{\mathrm  {cut}} \approx 10$ kpc retains roughly 5--10\% of the potential from the outer halo; at $r_{\mathrm  {cut}} \approx 30$ kpc, this drops below 1\%. This diagnostic directly guides the choice of truncation radius: if the outer halo contributes significantly to the potential at the radii of interest (e.g., $r < 1$ kpc for the central density), then the outer region must be represented accurately.}}{36}{figure.caption.19}\protected@file@percent }
\newlabel{fig:results_shell_cutoff}{{4.11}{36}{\textbf {Outer-potential fraction versus cutoff radius.} For probe radii ranging from the center to $r = 5 r_s$, the fraction of the potential originating from material beyond the cutoff radius $r_{\mathrm {cut}}$ is plotted against the cutoff. As the cutoff moves outward, the outer contribution drops sharply initially, then plateaus. For the central region ($r_{\mathrm {probe}} < r_s$), a cutoff at $r_{\mathrm {cut}} \approx 10$ kpc retains roughly 5--10\% of the potential from the outer halo; at $r_{\mathrm {cut}} \approx 30$ kpc, this drops below 1\%. This diagnostic directly guides the choice of truncation radius: if the outer halo contributes significantly to the potential at the radii of interest (e.g., $r < 1$ kpc for the central density), then the outer region must be represented accurately}{figure.caption.19}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.8.4}2D outer-fraction map}{36}{subsection.4.8.4}\protected@file@percent }
\BKM@entry{id=61,dest={73756273656374696F6E2E342E382E35},srcline={255}}{}
\@writefile{lof}{\contentsline {figure}{\numberline {4.12}{\ignorespaces \textbf  {2D map of the outer-potential fraction.} Rows represent probe radii; columns represent cutoff radii. The color intensity indicates the fraction of potential at a given probe radius arising from material beyond the cutoff. The transition from high (red) to low (blue) values shows the radius beyond which the outer halo becomes a small correction. This visualization is useful for selecting practical values of $r_{\mathrm  {cut}}$ for different regions of interest.}}{37}{figure.caption.20}\protected@file@percent }
\newlabel{fig:results_shell_map}{{4.12}{37}{\textbf {2D map of the outer-potential fraction.} Rows represent probe radii; columns represent cutoff radii. The color intensity indicates the fraction of potential at a given probe radius arising from material beyond the cutoff. The transition from high (red) to low (blue) values shows the radius beyond which the outer halo becomes a small correction. This visualization is useful for selecting practical values of $r_{\mathrm {cut}}$ for different regions of interest}{figure.caption.20}{}}
